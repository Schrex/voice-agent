# Every environment variable the code reads. Copy to `.env` (git-ignored) for local use;
# staging/prod values live in the host's env vars and GitHub secrets (docs/staging.md), never here.
# Tickets that add a setting append it here.

# --- Backend runtime (backend/app/config.py) ---
# Deployment name: local | staging | prod. Tags Sentry events. Defaults to local.
APP_ENV=local
# App database (SQLAlchemy URL, psycopg 3 driver). Staging: Supabase staging project, session pooler.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/voice_agent
# Sentry project DSN. Leave empty to turn error reporting off (local, CI).
SENTRY_DSN=
# Port the server listens on; set by Render, used only in render.yaml's start command.
PORT=8000
# Shared secret ElevenLabs sends as X-Hook-Secret on POST /hooks/call-start. Unset: every call-start is rejected (401).
HOOK_SECRET=
# Shared secret ElevenLabs sends as X-Tool-Secret on every POST /tools/*. Unset: every tool call is rejected (401).
TOOL_SECRET=
# HMAC secret ElevenLabs generates for the post-call webhook; verifies ElevenLabs-Signature on POST /hooks/post-call. Unset: every delivery is rejected (401).
ELEVENLABS_WEBHOOK_SECRET=
# Main office number spoken to unrostered callers (spec J8), inserted verbatim, e.g. 585-555-0100. Required.
OFFICE_MAIN_NUMBER=
# Supabase project's JWT secret (Settings > API > JWT secret). The backend verifies dashboard
# access tokens (HS256) with it. Server-only: never give it a VITE_ prefix.
SUPABASE_JWT_SECRET=
# Built dashboard served at `/`. Defaults to frontend/dist; set only if the build lives elsewhere.
FRONTEND_DIST=
# ElevenLabs API key and optional API base override: the backend streams call recordings from
# ElevenLabs to the dashboard (GET /api/calls/{id}/audio) and push.py syncs the agent. Unset key:
# recordings answer 502, nothing else is affected. Base defaults to https://api.elevenlabs.io.
# (Listed once, under "Agent sync" below.)
# Twilio Messaging for alert SMS (e.g. a new Today request to the on-duty Coordinator). Same account
# as the voice number. Any of the three unset: no SMS is sent; each alert is recorded as failed and
# shown on the dashboard. API base defaults to https://api.twilio.com.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Number alert SMS come from, E.164 (e.g. +15855550100); needs A2P 10DLC registration to deliver.
TWILIO_FROM_E164=
TWILIO_API_BASE=
# Scheduled jobs (architecture §6: Overdue sweep every minute) run inside the app process.
# On unless false/0/off; turn off in any extra process that must not run them.
SCHEDULER_ENABLED=true

# --- Dashboard build (frontend/; Vite reads these at build time, from frontend/.env or the env) ---
# Only these two reach the browser. The Supabase service key never does (CI checks the bundle).
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=

# --- ElevenLabs API (backend/agent/push.py, run by a person or CI; and the server's recording proxy) ---
# ElevenLabs API key for the workspace holding the env's agent. Per-env names/URLs live in backend/agent/envs.json.
ELEVENLABS_API_KEY=
# Optional API base override; defaults to https://api.elevenlabs.io.
ELEVENLABS_API_BASE=

# --- Tests (tests/integration/conftest.py) ---
# Throwaway database; the integration tests wipe its `public` schema.
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/voice_agent_test
# Tests and CI run in the office's time zone.
TZ=America/New_York
# Playwright (frontend/playwright.config.ts): a disposable database it migrates and seeds, and the
# port the backend under test listens on.
E2E_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/voice_agent_e2e
E2E_PORT=8765
# Port of the ElevenLabs audio stub the backend under Playwright streams recordings from.
E2E_ELEVENLABS_PORT=8766

# --- Deploy workflow (.github/workflows/deploy-staging.yml): GitHub settings, not app env ---
# Secret RENDER_API_KEY; variables RENDER_STAGING_SERVICE_ID, STAGING_URL. Listed for completeness.
# RENDER_API_KEY=
# RENDER_STAGING_SERVICE_ID=
# STAGING_URL=
