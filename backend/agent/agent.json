{
  "name": "${agent_name}",
  "conversation_config": {
    "agent": {
      "language": "en",
      "first_message": "Hi {{foreman_first_name}}, this is the Schreiber Excavating automated assistant. This call is recorded. What do you need?",
      "dynamic_variables": {
        "dynamic_variable_placeholders": {
          "rejected": false,
          "foreman_first_name": "",
          "jobs": "",
          "now_local": ""
        }
      },
      "prompt": {
        "llm": "claude-sonnet-5-5",
        "timezone": "America/New_York",
        "built_in_tools": {
          "end_call": {
            "type": "system",
            "name": "end_call",
            "description": "End the call. Use it right after the rejection line when the caller is not on the Roster, and when the foreman is done.",
            "params": { "system_tool_type": "end_call" }
          }
        }
      }
    },
    "tts": {
      "model_id": "eleven_flash_v2",
      "voice_id": "21m00Tcm4TlvDq8ikWAM"
    }
  },
  "platform_settings": {
    "overrides": {
      "enable_conversation_initiation_client_data_from_webhook": true,
      "conversation_config_override": {
        "agent": { "first_message": true }
      }
    },
    "workspace_overrides": {
      "conversation_initiation_client_data_webhook": {
        "url": "${backend_url}/hooks/call-start",
        "request_headers": {
          "X-Hook-Secret": { "secret_id": "${hook_secret_id}" }
        }
      }
    }
  }
}
