{
  "name": "AC1.7 says recorded and not yet confirmed and gives the reference",
  "type": "simulation",
  "dynamic_variables": {
    "rejected": false,
    "foreman_first_name": "Dale",
    "jobs": "Penfield Sewer Replacement; Route 104 Widening",
    "now_local": "Sunday, November 1, 2026, 3:04 PM"
  },
  "simulation_scenario": "You are Dale, a foreman on the Roster. When the assistant asks what you need, say: you need one excavator operator at the Penfield job tomorrow at 6:30 AM. When the assistant reads the details back and asks whether to submit, say yes. After it answers, say that's all and goodbye.",
  "simulation_max_turns": 8,
  "success_conditions": [
    "After the request is submitted, the agent says it is recorded and sent to the office and explicitly says it is not confirmed yet.",
    "After the request is submitted, the agent gives the reference number R-1042.",
    "The agent never says the request is confirmed, approved, scheduled or on its way, and never says when anyone will act on it."
  ],
  "tool_mock_config": {
    "mocking_strategy": "selected",
    "mocked_tool_ids": [
      "${tool_find_jobs}",
      "${tool_resolve_needed_by}",
      "${tool_submit_requests}",
      "${tool_find_open_requests}",
      "${tool_create_callback_request}",
      "${tool_add_note}",
      "${tool_transfer_to_office}",
      "${tool_find_duplicates}",
      "${tool_amend_request}",
      "${tool_withdraw_request}"
    ],
    "fallback_strategy": "raise_error"
  },
  "tool_mock_overrides": {
    "${tool_find_jobs}": [
      {
        "mock_result": "[{\"job_id\": 12, \"name\": \"Penfield Sewer Replacement\", \"score\": 92}]",
        "is_error": false
      }
    ],
    "${tool_resolve_needed_by}": [
      {
        "mock_result": "{\"needed_by_resolved\": \"Monday, November 2 at 6:30 AM\", \"urgency\": \"Planned\"}",
        "is_error": false
      }
    ],
    "${tool_submit_requests}": [
      {
        "mock_result": "[{\"ref\": \"R-1042\", \"needed_by_resolved\": \"Monday, November 2 at 6:30 AM\", \"urgency\": \"Planned\"}]",
        "is_error": false
      }
    ],
    "${tool_find_open_requests}": [
      {
        "mock_result": "[]",
        "is_error": false
      }
    ],
    "${tool_create_callback_request}": [
      {
        "mock_result": "{\"error\": \"The callback request could not be saved.\"}",
        "is_error": false
      }
    ],
    "${tool_add_note}": [
      {
        "mock_result": "{\"ok\": true}",
        "is_error": false
      }
    ],
    "${tool_transfer_to_office}": [
      {
        "mock_result": "{\"ok\": true}",
        "is_error": false
      }
    ],
    "${tool_find_duplicates}": [
      {
        "mock_result": "[]",
        "is_error": false
      }
    ],
    "${tool_amend_request}": [
      {
        "mock_result": "{\"error\": \"The change could not be saved.\"}",
        "is_error": false
      }
    ],
    "${tool_withdraw_request}": [
      {
        "mock_result": "{\"error\": \"The request could not be withdrawn.\"}",
        "is_error": false
      }
    ]
  }
}
